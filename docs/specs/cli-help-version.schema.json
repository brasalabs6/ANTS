{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ANTS R01 CLI JSON envelope (experimental)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ok",
        "data"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "runtime",
                "revision"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "runtime": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|source|dirty|unavailable)$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commands"
              ],
              "properties": {
                "commands": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "description"
                    ],
                    "properties": {
                      "name": {
                        "enum": [
                          "help",
                          "version"
                        ]
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ok",
        "error"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "requestId",
            "retryable",
            "nextStep"
          ],
          "properties": {
            "code": {
              "enum": [
                "usage",
                "unavailable"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "requestId": {
              "type": "string",
              "format": "uuid"
            },
            "retryable": {
              "const": false
            },
            "nextStep": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
