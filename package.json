{
  "name": "ants-workspace",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": "1.3.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "cli": "bun apps/ants/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check apps packages scripts tests && bun scripts/check-boundaries.ts",
    "build": "bun scripts/build.ts",
    "check": "bun run lint && bun run typecheck && bun test && bun run test:negative && bun run build",
    "format": "biome format --write apps packages scripts tests",
    "test:negative": "bun scripts/check-negative.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "5.9.3",
    "@biomejs/biome": "2.3.8"
  },
  "dependencies": {
    "@ants/storage-sqlite": "workspace:*"
  }
}
